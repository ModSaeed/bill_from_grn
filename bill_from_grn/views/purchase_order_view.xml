<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Purchase Order Form View to Add Combined Bill Button -->
        <record id="view_purchase_order_form_inherit_combined_bill" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.combined.bill</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Add Combined Bill button to header -->
                <xpath expr="//header" position="inside">
                    <button name="action_create_combined_vendor_bill"
                            string="Create Bill From GRN"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('purchase', 'done') or invoice_status in ('no', 'invoiced')"
                            groups="bill_from_grn.group_bill_creator"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>