<odoo>
    <data>
        <record id="view_move_form_inherit_show_grns" model="ir.ui.view">
            <field name="name">account.move.form.inherit.grn</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_reference']" position="after">
                        <field name="grn_ids" widget="many2many_tags" readonly="1" force_save="1"
                               invisible="move_type not in ('in_invoice','in_refund')"/>
                    </xpath>
            </field>
        </record>

        <record id="view_move_tree_inherit_show_grns" model="ir.ui.view">
            <field name="name">stock.picking.tree.purchase.bill</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="grn_ids" widget="many2many_tags" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>